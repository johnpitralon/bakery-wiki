# Lokální LLM — konfigurace wiki update
# Zkopíruj: cp triggers/local-models.env.example triggers/local-models.env

# --- Ollama (default) ---
WIKI_LLM_BASE_URL=http://127.0.0.1:11434/v1
WIKI_LLM_MODEL=qwen2.5:7b
WIKI_LLM_API_KEY=ollama

# --- LM Studio ---
# WIKI_LLM_BASE_URL=http://127.0.0.1:1234/v1
# WIKI_LLM_MODEL=local-model
# WIKI_LLM_API_KEY=lm-studio

# --- LiteLLM / Open WebUI gateway (Kind pilot) ---
# WIKI_LLM_BASE_URL=http://llm-gateway.bakery-agent-infra.svc.cluster.local:4000/v1
# WIKI_LLM_MODEL=ollama/qwen2.5-coder
# WIKI_LLM_API_KEY=sk-local

# --- vLLM / text-generation-webui ---
# WIKI_LLM_BASE_URL=http://127.0.0.1:5000/v1

WIKI_LLM_TIMEOUT_SEC=600
WIKI_LLM_MAX_TOKENS=16384

# Volitelně: hotový prompt bundle (jinak se sestaví automaticky)
# WIKI_PROMPT_BUNDLE=triggers/out/LATEST-prompt.md
